    // ---------- {{forStage}} 4 ----------
    @PluginInfo(version = "1.2")
    public static class UpperPlugin implements Plugin {
        public String name() { return "upper"; }
        public String apply(String s) { return s.toUpperCase(); }
    }
    public static class ReversePlugin implements Plugin {
        public String name() { return "reverse"; }
        public String apply(String s) { return new StringBuilder(s).reverse().toString(); }
    }
    public static class NotAPlugin { }
    public static class NoDefaultCtor implements Plugin {
        public NoDefaultCtor(int x) { }
        public String name() { return "x"; }
        public String apply(String s) { return s; }
    }

