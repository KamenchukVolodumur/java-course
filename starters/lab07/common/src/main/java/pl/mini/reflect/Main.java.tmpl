    public static class BasicTests {
        private List<Integer> data;
        @BeforeEach void setUp() { data = new ArrayList<>(List.of(1, 2, 3)); }
        @Test void addsElement() { data.add(4); Assert.equal(4, data.size()); }
        @Test void freshDataEachTime() { Assert.equal(3, data.size()); }
        @Test @Disabled void notReady() { throw new IllegalStateException(); }
        void helper() { throw new IllegalStateException("{{helperMsg}}"); }
    }

